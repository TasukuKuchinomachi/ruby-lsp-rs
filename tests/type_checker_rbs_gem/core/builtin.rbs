class BasicObject
  def initialize: () -> void

  def !: () -> bool

  def ==: (untyped other) -> bool
end

class Object < BasicObject
  include Kernel

  def to_s: () -> String

  def frozen?: () -> bool
end

module Kernel : BasicObject
  private

  def puts: (*untyped objects) -> nil
end

class Module
  def attr_reader: (*Symbol names) -> Array[Symbol]
end

class Class < Module
  def new: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
end

# A sequence of characters
class String
  def +: (String other) -> String

  # Returns the string in upper case
  def upcase: () -> String

  def size: () -> Integer

  def center: (Integer width, ?String padding) -> String
end

class Integer
  def +: (Integer other) -> Integer

  def *: (Integer other) -> Integer

  def to_s: () -> String
end

class Float
end

class Symbol
end

class NilClass
end

class TrueClass
end

class FalseClass
end

class Array[unchecked out Elem]
  def each: () { (Elem item) -> void } -> self

  def first: () -> Elem?
end

class Hash[unchecked out K, unchecked out V]
end

class Range[out Elem]
end

class Proc
end

class Regexp
end

class Exception
end

class StandardError < Exception
end
