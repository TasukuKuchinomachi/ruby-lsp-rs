# A point in a plane.
class Point
  # The horizontal coordinate.
  attr_reader x: Integer

  attr_reader y: Integer

  # Creates a point.
  def initialize: (Integer x, Integer y) -> void

  # Moves the point.
  def move: (dx: Integer, ?dy: Integer) -> Point
          | (Point other) -> Point

  def distance: (Point other, ?round: bool, **untyped options) -> Float

  def each_coordinate: () { (Integer) -> void } -> void

  def self.origin: () -> Point

  def to_s: () -> String

  alias inspect to_s

  @label: String?
end
